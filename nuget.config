<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      MinGo.ServiceRegistry.Abstractions is consumed as a NuGet package published
      to nuget.org, so it is restored from the nuget.org source above.
      This file does NOT <clear/> sources, so any machine-level feeds (e.g. the
      'mingo-local' feed registered by ../local/build-local.ps1) remain visible for
      local development; they do not shadow the published package because the pinned
      version is restored from nuget.org.
    -->
  </packageSources>
</configuration>
