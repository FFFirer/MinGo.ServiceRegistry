<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      MinGo.ServiceRegistry.Abstractions is consumed as a NuGet package.
      - Local development: the workspace bootstrap (../local/build-local.ps1) registers a
        machine-level source 'mingo-local' pointing at ../local/artifacts. Because this file
        does NOT <clear/> sources, that machine-level feed remains visible here.
      - CI: the server workflow adds the real feed (nuget.org / GitHub Packages) that hosts
        the published Abstractions package.
    -->
  </packageSources>
</configuration>
