@*
    Material Design 3 linear progress indicator (indeterminate).
*@

<div class="w-full @Class" style="@Style" role="progressbar" aria-label="@Label" @attributes="AdditionalAttributes">
    <div class="h-1 w-full rounded-md-xs bg-md-surface-variant overflow-hidden">
        <div class="h-full w-1/3 bg-md-primary rounded-md-xs animate-[md-indeterminate_1.4s_ease-in-out_infinite]"></div>
    </div>
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="mt-2 text-md-body-small text-md-on-surface-variant">@Label</div>
    }
</div>

@code {
    /// <summary>Optional descriptive label rendered below the track.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Extra CSS classes.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Inline style.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Splat target.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
