@*
    Material Design 3 lightweight data table. Callers supply columns and a row template.
    Uses a plain <table> so screen readers and browser find-in-page keep working.
*@

@typeparam TItem

<div class="w-full overflow-x-auto rounded-md-md border border-md-outline-variant bg-md-surface @Class" style="@Style">
    <table class="w-full text-md-body">
        <thead class="bg-md-surface-container text-md-on-surface-variant">
            <tr>
                @foreach (var column in Columns)
                {
                    <th scope="col"
                        class="px-4 py-3 text-left font-medium text-md-label-small uppercase tracking-wider @column.HeaderClass"
                        style="@column.HeaderStyle">
                        @column.Title
                    </th>
                }
            </tr>
        </thead>
        <tbody class="divide-y divide-md-outline-variant">
            @if (Items is null || !Items.Any())
            {
                <tr>
                    <td colspan="@Columns.Count" class="px-4 py-10 text-center text-md-on-surface-variant">
                        @EmptyContent
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Items)
                {
                    <tr class="hover:bg-md-surface-container/60 transition-colors">
                        @RowTemplate(item)
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    /// <summary>Column descriptor for <see cref="M3DataTable{TItem}"/>.</summary>
    public sealed class Column
    {
        /// <summary>Header text.</summary>
        public string Title { get; init; } = string.Empty;

        /// <summary>Extra CSS classes applied to the header cell.</summary>
        public string? HeaderClass { get; init; }

        /// <summary>Inline style applied to the header cell.</summary>
        public string? HeaderStyle { get; init; }
    }

    /// <summary>Column definitions.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Column> Columns { get; set; } = Array.Empty<Column>();

    /// <summary>Row items.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Row template; receives one item and must emit one <c>&lt;td&gt;</c> per column.</summary>
    [Parameter, EditorRequired] public RenderFragment<TItem> RowTemplate { get; set; } = default!;

    /// <summary>Rendered inside a single spanning cell when <see cref="Items"/> is empty.</summary>
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    /// <summary>Extra CSS classes applied to the outer wrapper.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Inline style applied to the outer wrapper.</summary>
    [Parameter] public string? Style { get; set; }
}
