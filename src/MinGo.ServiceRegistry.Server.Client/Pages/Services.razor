@page "/"
@inject RegistryApiClient Api

<PageTitle>Services - MinGo Registry</PageTitle>

<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-end gap-4">
        <div class="min-w-0">
            <h1 class="text-md-headline text-md-on-surface">Services</h1>
            <p class="mt-1 text-md-body text-md-on-surface-variant">
                All service names currently registered in the store.
            </p>
        </div>
        <div class="ml-auto flex items-center gap-2">
            <div class="relative">
                <input type="search" @bind="Filter" @bind:event="oninput" placeholder="Filter services"
                       class="h-10 w-56 md:w-72 rounded-md-xl bg-md-surface-container border border-md-outline-variant px-4 text-md-body text-md-on-surface placeholder:text-md-on-surface-variant/70 focus:outline-none focus:border-md-primary focus:ring-2 focus:ring-md-primary/30" />
            </div>
            <M3Button Variant="M3Button.ButtonVariant.Tonal" Label="Refresh" Icon="&#8635;" OnClick="LoadAsync" Disabled="@Loading" />
        </div>
    </div>

    @if (Error is not null)
    {
        <M3Card Variant="M3Card.CardVariant.Outlined" Headline="Failed to load services" SupportingText="@Error">
            <M3Button Variant="M3Button.ButtonVariant.Filled" Label="Retry" OnClick="LoadAsync" />
        </M3Card>
    }
    else if (Loading && ServicesSnapshot is null)
    {
        <M3Card>
            <M3Progress Label="Loading services..." />
        </M3Card>
    }
    else if (ServicesSnapshot is { Count: 0 })
    {
        <M3Card>
            <M3EmptyState Icon="&#128269;"
                          Headline="No services registered"
                          SupportingText="Once a client POSTs to /api/registry/services/{name}/instances, entries appear here." />
        </M3Card>
    }
    else
    {
        <M3DataTable TItem="ServiceRow" Columns="_columns" Items="VisibleRows">
            <RowTemplate>
                <td class="px-4 py-3 font-medium text-md-on-surface">@context.Name</td>
                <td class="px-4 py-3 text-md-on-surface-variant">
                    @if (context.Count is null)
                    {
                        <span class="opacity-60">loading...</span>
                    }
                    else
                    {
                        @context.Count.Value
                    }
                </td>
                <td class="px-4 py-3 text-right">
                    <M3Button Variant="M3Button.ButtonVariant.Text" Label="Details" Href="@($"services/{Uri.EscapeDataString(context.Name)}")" />
                </td>
            </RowTemplate>
            <EmptyContent>
                <span>No services match "@Filter".</span>
            </EmptyContent>
        </M3DataTable>
    }
</div>

@code {
    private sealed record ServiceRow(string Name, int? Count);

    private static readonly IReadOnlyList<M3DataTable<ServiceRow>.Column> _columns = new[]
    {
        new M3DataTable<ServiceRow>.Column { Title = "Service" },
        new M3DataTable<ServiceRow>.Column { Title = "Instances" },
        new M3DataTable<ServiceRow>.Column { Title = "", HeaderClass = "text-right" },
    };

    private IReadOnlyList<ServiceRow>? ServicesSnapshot { get; set; }
    private string Filter { get; set; } = string.Empty;
    private bool Loading { get; set; }
    private string? Error { get; set; }

    private IEnumerable<ServiceRow> VisibleRows
    {
        get
        {
            var rows = ServicesSnapshot ?? Array.Empty<ServiceRow>();
            if (string.IsNullOrWhiteSpace(Filter))
            {
                return rows;
            }

            return rows.Where(r => r.Name.Contains(Filter, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        StateHasChanged();
        try
        {
            var services = await Api.GetServicesAsync();
            // Fan out to fetch per-service instance counts so the list can show meaningful numbers.
            var tasks = services.Services.Select(async name =>
            {
                try
                {
                    var detail = await Api.GetInstancesAsync(name);
                    return new ServiceRow(name, detail.Instances.Count);
                }
                catch (HttpRequestException)
                {
                    return new ServiceRow(name, null);
                }
            });
            var rows = await Task.WhenAll(tasks);
            ServicesSnapshot = rows
                .OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray();
        }
        catch (HttpRequestException ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }
}
